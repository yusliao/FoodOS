# Copy to foodos.env on the server. Never commit the real file.
# nginx renders the frontend /config.json files from these URLs at startup.
FOODOS_RELEASE_DIR=./releases/20260928-ip2
FOODOS_API_URL=http://152.42.249.157:18080
FOODOS_ADMIN_URL=http://152.42.249.157:18081
FOODOS_DASHBOARD_URL=http://152.42.249.157:18082
FOODOS_MINIO_URL=http://152.42.249.157:18083

FOODOS_API_PORT=18080
FOODOS_ADMIN_PORT=18081
FOODOS_DASHBOARD_PORT=18082
FOODOS_MINIO_PORT=18083

# Dedicated database and role inside the existing checkpay-postgres server.
# Use a password without semicolons or commas in these connection strings.
FOODOS_DB_CONNECTION=Host=checkpay-postgres;Port=5432;Database=foodos;Username=foodos;Password=admin123

# Generate independent values; do not reuse CheckPay or 1115goods secrets.
FOODOS_VALKEY_PASSWORD=admin123
FOODOS_JWT_SIGNING_KEY=3d11c141e92ce1352f0f2931904a0ac0a5371811d16d0d49e8565453e72badc501eeac9358234deeadc2dbce672f57fd
FOODOS_SEED_ADMIN_PASSWORD=e20ea5f762e47959286e2a98d9d3695c75e26376d9f1be6d9a041c157e6278af
FOODOS_HANGFIRE_USERNAME=foodos_jobs
FOODOS_HANGFIRE_PASSWORD=e20ea5f762e47959286e2a98d9d3695c75e26376d9f1be6d9a041c157e6278af

# Dedicated MinIO user with access only to the private foodos bucket.
FOODOS_MINIO_ACCESS_KEY=foodos
FOODOS_MINIO_SECRET_KEY=adb16d2ce0d4ce5de8d1f523c72b6dad55a96583fbd4ba12a3a8d1a2e919f974